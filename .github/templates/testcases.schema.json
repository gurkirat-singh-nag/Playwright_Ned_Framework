{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://qatalyst-replica.local/templates/testcases.schema.json",
  "title": "Testcases",
  "description": "Machine-readable artifact contract for testcases.json, produced by the Test Case Documenter Skill and consumed by the Page Object Generator and Test Script Generator Skills. Must stay 1:1 consistent with test-cases.md.",
  "type": "object",
  "required": ["storyId", "testCases"],
  "additionalProperties": false,
  "properties": {
    "storyId": {
      "type": "string",
      "description": "Jira Story ID, or kebab-case slug when no Jira ID exists. Matches the artifacts/<slug>/ directory name."
    },
    "testCases": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/definitions/testCase" }
    }
  },
  "definitions": {
    "testCase": {
      "type": "object",
      "required": [
        "id",
        "storyId",
        "title",
        "category",
        "priority",
        "preconditions",
        "steps",
        "expectedResults",
        "tags",
        "dependencies",
        "targetPage",
        "requiredPageObjects"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^TC-[0-9]{3,}$",
          "description": "Stable Test Case ID, e.g. TC-001. Must match the ID used in test-cases.md and in the generated spec's test title."
        },
        "storyId": {
          "type": "string",
          "description": "Jira Story ID this test case belongs to."
        },
        "title": {
          "type": "string",
          "description": "Short, action-oriented test case title."
        },
        "category": {
          "type": "string",
          "enum": ["positive", "negative", "boundary", "regression"]
        },
        "priority": {
          "type": "string",
          "enum": ["P1", "P2", "P3"]
        },
        "preconditions": {
          "type": "array",
          "items": { "type": "string" }
        },
        "steps": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["stepNumber", "action", "expectedResult"],
            "additionalProperties": false,
            "properties": {
              "stepNumber": { "type": "integer", "minimum": 1 },
              "action": { "type": "string" },
              "testData": { "type": "string" },
              "expectedResult": { "type": "string" }
            }
          }
        },
        "expectedResults": {
          "type": "string",
          "description": "Overall expected outcome of the test case."
        },
        "tags": {
          "type": "array",
          "items": { "type": "string" }
        },
        "dependencies": {
          "type": "array",
          "items": { "type": "string" },
          "description": "IDs of other test cases that must run before this one, if any."
        },
        "targetPage": {
          "type": "string",
          "description": "Primary page or screen this test case exercises, as named in exploration.md."
        },
        "requiredPageObjects": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Page Object class names this test case depends on, once generated by the Page Object Generator Skill."
        }
      }
    }
  }
}
